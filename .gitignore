####################################
#   ФАЙЛИ ТА ПАПКИ, ЯКІ ІГНОРУЄМО  #
####################################

# -------------------------
# Node.js та менеджери пакетів
# -------------------------
node_modules/       # Усі встановлені npm/yarn пакети (вагає багато, ставиться локально)
npm-debug.log*      # Логи помилок npm
yarn-debug.log*
yarn-error.log*
package-lock.json   # Файл блокування npm (залежно від підходу може бути в репо, але тут ігноруємо)
yarn.lock           # Аналогічно для yarn

# -------------------------
# Gulp та кеші
# -------------------------
.cache/             # Кеш Gulp/Webpack
tmp/                # Тимчасові файли під час збірки

# -------------------------
# Prepros
# -------------------------
prepros.cfg
prepros.config
*.prepros
*.prepros.cfg
.prepros/           # Папка конфігів Prepros

# -------------------------
# PhpStorm / WebStorm
# -------------------------
.idea/              # Налаштування IDE JetBrains
*.iml
*.iws
out/                # Папка компіляції (якщо є)

# -------------------------
# Системні файли (Windows / macOS)
# -------------------------
.DS_Store           # macOS службовий файл
Thumbs.db           # Windows кеш зображень
ehthumbs.db
Desktop.ini

# -------------------------
# Логи
# -------------------------
*.log
logs/
pids/
*.pid
*.seed
*.pid.lock

# -------------------------
# Папки/файли збірки
# -------------------------
dist/               # Папка з фінальною збіркою (Gulp/Webpack)
build/
public/build/
coverage/           # Звіти про покриття тестами

# -------------------------
# PHP
# -------------------------
vendor/             # Composer залежності
composer.lock       # Файл блокування (ігноруємо, якщо не хочемо фіксувати версії)

# -------------------------
# Тимчасові файли
# -------------------------
*.tmp
*.temp
*.swp
*.swo
*.bak
*.orig

# -------------------------
# SASS / LESS кеш
# -------------------------
.sass-cache/
*.css.map           # Карти стилів (якщо не потрібні в репо)

# -------------------------
# Секрети та конфіги середовища
# -------------------------
.env                # Основний файл змінних середовища
.env.*              # Додаткові варіанти (.env.local, .env.prod і т.д.)
